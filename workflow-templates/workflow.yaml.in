name: Build AKMODs
on:
  merge_group:
  pull_request:
    branches:
      - main
    paths-ignore:
      - '**.md'
  schedule:
    - cron: '%%CRON_MINUTE%% 0 * * *'  # staggered minute past 00:00 UTC, see Justfile generate-workflows
  workflow_dispatch:
    inputs:
      force:
        description: "Force build all targets (ignore fingerprint guard)"
        type: boolean
        default: false
